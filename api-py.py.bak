"""
FastAPI wrapper for the Multi-Agent Agentic Semantic Layer.
Deploy to Cloud Run or run locally with: uvicorn api:app --host 0.0.0.0 --port 8080
"""

import os
import json
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
from agentic_semantic_layer import (
    AgenticSemanticLayer,
    AgenticConfig,
    AutoDiscovery,
)

# ─── Init ───

app = FastAPI(
    title="Multi-Agent Semantic Layer API",
    description="Translates natural language to BigQuery SQL via 6 AI agents",
    version="2.0",
)

config = AgenticConfig()
sl = AgenticSemanticLayer(config)

# In-memory trace history (last N queries)
_trace_history: list[dict] = []
_MAX_TRACES = 50


# ─── Models ───

class QueryReq(BaseModel):
    question: str


class QueryResp(BaseModel):
    question: str
    question_type: str
    synthesis: str
    confidence: float
    sub_questions_count: int
    successful_findings: int
    sql_queries: list[str]
    findings: list[dict]
    trace: dict


class TableReg(BaseModel):
    project: str
    dataset: str
    table: str
    columns: list[dict]
    description: str = ""


class MetricReg(BaseModel):
    name: str
    expression: str
    table_fqn: str
    description: str = ""


class ConceptReg(BaseModel):
    concept: str
    description: str
    maps_to: list[str]
    synonyms: list[str] = []
    calculation_hint: str = ""


class ExampleReg(BaseModel):
    question: str
    sql: str
    tables_used: list[str]
    complexity: str = "simple"


# ─── Query Endpoint ───

@app.post("/query", response_model=QueryResp)
async def query(req: QueryReq):
    """Ask a natural language question. Returns SQL, insights, and data."""
    try:
        r = sl.query(req.question)

        # Store trace in history
        _trace_history.append({
            "trace_id": r.trace.get("trace_id"),
            "question": r.question,
            "question_type": r.question_type,
            "confidence": r.confidence,
            "trace": r.trace,
            "timestamp": r.metadata.get("timestamp"),
        })
        if len(_trace_history) > _MAX_TRACES:
            _trace_history.pop(0)

        return QueryResp(
            question=r.question,
            question_type=r.question_type,
            synthesis=r.synthesis,
            confidence=r.confidence,
            sub_questions_count=len(r.plan.get("sub_questions", [])),
            successful_findings=r.metadata.get("successful_findings", 0),
            sql_queries=r.sql_queries,
            findings=r.findings,
            trace=r.trace,
        )
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e)[:500])


# ─── Admin Endpoints ───

@app.post("/admin/reload")
async def reload():
    """Reload ontology from GCS/Neo4j and re-index vectors."""
    sl.reload_ontology()
    return {"status": "reloaded", "mode": sl.mode}


@app.get("/admin/ontology")
async def ontology():
    """Return the full current ontology as JSON."""
    return sl.get_ontology()


@app.get("/admin/catalog")
async def catalog():
    """List all registered tables, concepts, and examples."""
    return {
        "tables": sl.list_tables(),
        "concepts": sl.list_concepts(),
        "examples": sl.list_examples(),
    }


@app.post("/admin/register-table")
async def register_table(req: TableReg):
    """Register a new table in the ontology."""
    sl.register_table(
        req.project, req.dataset, req.table,
        req.columns, req.description,
    )
    fqn = f"{req.project}.{req.dataset}.{req.table}"
    return {"status": "registered", "fqn": fqn}


@app.post("/admin/register-metric")
async def register_metric(req: MetricReg):
    """Register a business metric."""
    sl.register_metric(req.name, req.expression, req.table_fqn, req.description)
    return {"status": "registered", "metric": req.name}


@app.post("/admin/register-concept")
async def register_concept(req: ConceptReg):
    """Register a business concept with rich description."""
    sl.register_concept(
        req.concept, req.description, req.maps_to,
        req.synonyms, req.calculation_hint,
    )
    return {"status": "registered", "concept": req.concept}


@app.post("/admin/register-example")
async def register_example(req: ExampleReg):
    """Register a few-shot SQL example."""
    sl.register_example(
        req.question, req.sql, req.tables_used, req.complexity,
    )
    return {"status": "registered", "question": req.question}


@app.delete("/admin/unregister-table/{fqn:path}")
async def unregister_table(fqn: str):
    """Remove a table from the ontology."""
    sl.ont.remove_table(fqn)
    sl.ont.save()
    return {"status": "unregistered", "fqn": fqn}


@app.post("/admin/sync/{dataset}")
async def sync_dataset(
    dataset: str,
    project: str = "acn-uki-ds-data-ai-project",
):
    """Auto-discover tables in a BigQuery dataset and register them."""
    discovery = AutoDiscovery(sl)
    discovered = discovery.discover(project, dataset)
    discovery.infer_relationships(project, dataset)
    sl.reload_ontology(from_store=False)
    return {
        "status": "synced",
        "tables_discovered": len(discovered),
        "tables": discovered,
    }


# ─── Health ───

@app.get("/admin/traces")
async def list_traces():
    """List recent query traces (last 50)."""
    return {
        "total": len(_trace_history),
        "traces": [
            {
                "trace_id": t["trace_id"],
                "question": t["question"],
                "question_type": t["question_type"],
                "confidence": t["confidence"],
                "total_duration_ms": t["trace"]["total_duration_ms"],
                "total_steps": t["trace"]["total_steps"],
                "timestamp": t["timestamp"],
            }
            for t in reversed(_trace_history)
        ],
    }


@app.get("/admin/traces/{trace_id}")
async def get_trace(trace_id: str):
    """Get the full trace for a specific query by trace_id."""
    for t in _trace_history:
        if t["trace_id"] == trace_id:
            return t
    raise HTTPException(404, f"Trace {trace_id} not found")


@app.get("/admin/causal-map")
async def causal_map():
    """Return the structured causal map showing concept relationships."""
    ont = sl.get_ontology()
    return {
        "causal_map": ont.get("causal_map", []),
        "total_edges": len(ont.get("causal_map", [])),
    }


@app.get("/admin/causal-chain/{concept}")
async def causal_chain(concept: str):
    """Trace causes and effects for a specific concept."""
    if hasattr(sl.ont, "get_causal_chain"):
        chain = sl.ont.get_causal_chain(concept)
        return chain
    raise HTTPException(404, "Causal chain not available")


@app.get("/health")
async def health():
    return {
        "status": "ok",
        "mode": sl.mode,
        "agents": 6,
        "tables": len(sl.list_tables()),
        "concepts": len(sl.list_concepts()),
    }
