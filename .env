# ADK + Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=acn-uki-ds-data-ai-project
GOOGLE_CLOUD_LOCATION=europe-west2

# GCP
GCP_PROJECT=acn-uki-ds-data-ai-project
GCP_REGION=europe-west2
BQ_PROJECT=acn-uki-ds-data-ai-project
#BQ_DATASET=customer_sales_data_ai_agentic_semantic_layer
BQ_DATASET=telecom_network_analytics

# Neo4j (localhost)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=semantic-layer-password

# Neo4j (Cloud)
# NEO4J_URI=bolt://34.147.214.155:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=semantic-layer-password

# Vertex AI Vector Search (fill after provisioning)
# VS_INDEX_ENDPOINT_ID=projects/309116795114/locations/europe-west2/indexEndpoints/5563537632639582208
# VS_TABLES_INDEX_ID=projects/309116795114/locations/europe-west2/indexes/7277579503319121920
# VS_KPIS_INDEX_ID=projects/309116795114/locations/europe-west2/indexes/2754135890090524672
# VS_CONCEPTS_INDEX_ID=projects/309116795114/locations/europe-west2/indexes/6417814186956423168
# VS_EXAMPLES_INDEX_ID=projects/309116795114/locations/europe-west2/indexes/2778905688041062400

# # Deployed index IDs — must match what's deployed on the VS endpoint
# # Run: endpoint.deployed_indexes to list them, then set these values
# # If left as defaults, keyword fallback will be used (auto-populated from Neo4j)
# VS_TABLES_DEPLOYED_ID=tables_deployed
# VS_KPIS_DEPLOYED_ID=sl_kpis_deployed_1773927431123
# VS_CONCEPTS_DEPLOYED_ID=concepts_deployed
# VS_EXAMPLES_DEPLOYED_ID=examples_deployed

# Models
EMBEDDING_MODEL=text-embedding-005
GENERATIVE_MODEL=gemini-2.5-flash
# ROUTING_MODEL removed — Orchestrator and Investigator now use thinking_budget=0
# via BuiltInPlanner on gemini-2.5-flash instead of a separate model.

# Ontology setup
#ONTOLOGY_CONFIG=configs/retail/ontology.yaml
ONTOLOGY_CONFIG=configs/telecom/ontology.yaml
# SSL fix for corporate proxy (Accenture network injects self-signed CA cert)
# Option A: Point to your corporate CA bundle
REQUESTS_CA_BUNDLE=C:\certs\ca-bundle-with-websense.pem
SSL_CERT_FILE=C:\certs\ca-bundle-with-websense.pem
GRPC_DEFAULT_SSL_ROOTS_FILE_PATH=C:\certs\ca-bundle-with-websense.pem
#
# Option B: Disable SSL verify (NOT for production)
# CURL_CA_BUNDLE=
# REQUESTS_CA_BUNDLE=
# GRPC_DEFAULT_SSL_ROOTS_FILE_PATH=

# For current setup (Vector Search + Neo4j domains)
export SEARCH_MODE=current

# For Neo4j-only (no Vector Search)
# export SEARCH_MODE=neo4j_only

# For ontology in Vector Search (same as current)
# export SEARCH_MODE=ontology_vector